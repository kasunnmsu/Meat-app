generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StudyLocation {
  PUCPR
  UFBA
  NMSU
}

enum SubmissionKind {
  SESSION_1
  SESSION_2
  SESSION_3
  FULL_SURVEY
  CLICK_LOGS
}

// A participant is unique inside a study location. The same human-readable
// identifier may therefore be used independently at PUCPR, UFBA and NMSU.
model Participant {
  id           String
  location     StudyLocation
  demographics Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  submissions StudySubmission[]

  @@id([id, location])
  @@index([location])
}

// Stores the complete request exactly as it was received. Keeping the full
// JSON payload prevents a newly collected field from being silently lost.
model StudySubmission {
  id            String         @id @default(uuid())
  submissionId  String
  participantId String
  location      StudyLocation
  kind          SubmissionKind
  sessionNumber Int?
  payload       Json
  createdAt     DateTime       @default(now())

  participant Participant    @relation(fields: [participantId, location], references: [id, location], onDelete: Restrict)
  rows        StudyDataRow[]

  @@unique([submissionId, location, kind, participantId])
  @@index([location, kind, createdAt])
  @@index([participantId, location, sessionNumber])
}

// Each array in a request is also stored row by row. This makes exports and
// filters practical while the complete submission above remains the backup.
model StudyDataRow {
  id             BigInt         @id @default(autoincrement())
  submissionDbId String
  participantId  String
  location       StudyLocation
  kind           SubmissionKind
  sessionNumber  Int?
  dataset        String
  rowIndex       Int
  data           Json
  savedAt        DateTime       @default(now())

  submission StudySubmission @relation(fields: [submissionDbId], references: [id], onDelete: Cascade)

  @@unique([submissionDbId, dataset, rowIndex])
  @@index([location, dataset])
  @@index([participantId, location, sessionNumber])
}
